<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Proxy to Next.js frontend" stopProcessing="true">
          <match url=".*" />
          <action
            type="Rewrite"
            url="http://localhost:3000/{R:0}"
          />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
