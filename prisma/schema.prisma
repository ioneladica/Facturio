generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        String    @id @default(uuid())
  userId    String
  name      String
  email     String?
  phone     String?
  website   String?
  city      String?
  address   String?
  taxId     String?
  createdAt DateTime  @default(now()) @db.Timestamp(6)
  updatedAt DateTime  @default(now()) @db.Timestamp(6)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Invoice   Invoice[]

  @@unique([userId, id], map: "Client_userId_id_unique")
}

model CreditPack {
  id             String           @id @default(uuid())
  name           String
  credits        Int
  price          Decimal          @db.Decimal(12, 2)
  description    String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now()) @db.Timestamp(6)
  updatedAt      DateTime         @default(now()) @db.Timestamp(6)
  UserCreditPack UserCreditPack[]
}

model Invoice {
  id               String          @id @default(uuid())
  userId           String
  clientId         String
  invoiceNumber    Int?
  issueDate        DateTime?       @db.Timestamp(6)
  dueDate          DateTime?       @db.Timestamp(6)
  paidDate         DateTime?       @db.Timestamp(6)
  status           String          @default("DRAFT")
  currency         String          @default("RON")
  subtotal         Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount        Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount      Decimal         @default(0) @db.Decimal(12, 2)
  notes            String?
  userCreditPackId String?
  createdAt        DateTime        @default(now()) @db.Timestamp(6)
  updatedAt        DateTime        @default(now()) @db.Timestamp(6)
  Client           Client          @relation(fields: [userId, clientId], references: [userId, id], onDelete: NoAction, onUpdate: NoAction, map: "Invoice_client_owner_fk")
  UserCreditPack   UserCreditPack? @relation(fields: [userCreditPackId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User             User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  InvoiceItem      InvoiceItem[]
  InvoiceReminder  InvoiceReminder[]

  @@unique([userId, invoiceNumber], map: "Invoice_userId_number_unique")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  serviceId   String?
  description String
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal  @db.Decimal(12, 2)
  totalPrice  Decimal  @db.Decimal(12, 2)
  Invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Service     Service? @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
model InvoiceReminder {
  id        String   @id @default(uuid())
  invoiceId String
  message   String
  sentAt    DateTime @default(now())
  Invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}
model Payment {
  id                 String            @id @default(uuid())
  userId             String
  type               String
  userSubscriptionId String?
  userCreditPackId   String?
  amount             Decimal           @db.Decimal(12, 2)
  currency           String            @default("RON")
  paidAt             DateTime?         @db.Timestamp(6)
  UserCreditPack     UserCreditPack?   @relation(fields: [userCreditPackId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User               User              @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  UserSubscription   UserSubscription? @relation(fields: [userSubscriptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Service {
  id          String        @id @default(uuid())
  userId      String
  name        String
  description String?
  unitPrice   Decimal       @db.Decimal(12, 2)
  currency    String        @default("RON")
  createdAt   DateTime      @default(now()) @db.Timestamp(6)
  updatedAt   DateTime      @default(now()) @db.Timestamp(6)
  InvoiceItem InvoiceItem[]
  User        User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model SubscriptionPlan {
  id               String             @id @default(uuid())
  name             String
  description      String?
  price            Decimal            @db.Decimal(12, 2)
  billingPeriod    String
  invoiceLimit     Int
  isDefault        Boolean            @default(false)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now()) @db.Timestamp(6)
  updatedAt        DateTime           @default(now()) @db.Timestamp(6)
  UserSubscription UserSubscription[]
}

model User {
  id               String             @id @default(uuid())
  name             String
  email            String             @unique
  passwordHash     String
  role             String             @default("USER")
  status           String             @default("ACTIVE")
  phone            String?
  address          String?
  taxId            String?
  createdAt        DateTime           @default(now()) @db.Timestamp(6)
  updatedAt        DateTime           @default(now()) @db.Timestamp(6)
  Client           Client[]
  Invoice          Invoice[]
  Payment          Payment[]
  Service          Service[]
  UserCreditPack   UserCreditPack[]
  UserSubscription UserSubscription[]
}

model UserCreditPack {
  id               String     @id @default(uuid())
  userId           String
  creditPackId     String
  creditsPurchased Int
  creditsUsed      Int        @default(0)
  status           String     @default("ACTIVE")
  purchasedAt      DateTime   @default(now()) @db.Timestamp(6)
  Invoice          Invoice[]
  Payment          Payment[]
  CreditPack       CreditPack @relation(fields: [creditPackId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User             User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model UserSubscription {
  id               String           @id @default(uuid())
  userId           String
  planId           String
  status           String           @default("ACTIVE")
  startDate        DateTime         @db.Timestamp(6)
  endDate          DateTime?        @db.Timestamp(6)
  createdAt        DateTime         @default(now()) @db.Timestamp(6)
  updatedAt        DateTime         @default(now()) @db.Timestamp(6)
  Payment          Payment[]
  SubscriptionPlan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User             User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
